<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Flutter tool needs it to talk to the app during development. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 17 blocks private-network addresses (the emulator's 10.0.2.2 host) unless the app
         holds this permission, so the local Worker would be unreachable. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
