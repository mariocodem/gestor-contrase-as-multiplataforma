rules_version = '2';

// Each signed-in user can only touch their own vault. The data is already encrypted on the
// device, so these rules are a second line of defence, not the first.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
