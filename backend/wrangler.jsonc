{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boveda-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Daily cleanup of expired sessions, reset links and rate-limit windows (src/index.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boveda",
      // Replace with the id printed by `npx wrangler d1 create boveda` (see SETUP.md).
      // Local development and tests ignore it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated origins allowed to call the API from a browser (the Flutter web build).
    // "*" is acceptable because requests authenticate with a bearer token, not cookies.
    "ALLOWED_ORIGINS": "*",
    // Comma-separated emails that may create an account. Empty: anyone who finds the URL can
    // register (their data stays separate, but it is your D1). Set it to your own email.
    "ALLOWED_EMAILS": "",
    // Sender for password-reset emails, e.g. "Bóveda <boveda@tu-dominio.com>". Resets also need
    // the RESEND_API_KEY secret; without both, the app says resets are not configured.
    "MAIL_FROM": ""
  }
}
